{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sikhar",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sk",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sk",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.sk",
          "match": "\\b(rakha|badla|sthayi)\\b"
        },
        {
          "name": "keyword.control.sk",
          "match": "\\b(yadi|athawa|natra|jaba|ko_lagi|ma|rok|jaari|farka|koshish|samata|fal)\\b"
        },
        {
          "name": "keyword.reserved.sk",
          "match": "\\b(aayaat|pathaau|varg|nirmaan|gun|yo|sarbajanik|gopya|parkha|sangai|khola|banda|padh|lekh|hatau|hatāu|khoj|prakaar|jaach|suruwat|samapta)\\b"
        },
        {
          "name": "keyword.operator.logical.sk",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.sk",
          "match": "\\b(dekha|sodha|lamba|lambai|prakaar|jod_suchi|hatau_suchi|khoj_suchi|thulo|sano|ghat)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sk",
          "match": "\\b(sacho|jutho)\\b"
        },
        {
          "name": "constant.language.null.sk",
          "match": "\\b(khali)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.sk",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.sk",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.sk",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.sk",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.sk",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(kaam)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.sk" },
            "2": { "name": "entity.name.function.sk" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.sk" }
          }
        }
      ]
    }
  },
  "scopeName": "source.sk"
}
